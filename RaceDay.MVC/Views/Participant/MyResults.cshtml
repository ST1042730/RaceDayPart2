
@model List<RaceDay.MVC.Models.ParticipantResultViewModel>

@{
    ViewData["Title"] = "My Results";
}

<div class="container mt-4 mb-5">

    <div class="p-4 bg-dark text-white rounded mb-4">
        <h1>My Results</h1>
        <p class="mb-0">Track your race performance and achievements.</p>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No race results are available yet.
            Your results will appear here once an organiser records them.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Race</th>
                        <th>Position</th>
                        <th>Finish Time</th>
                        <th>Status</th>
                        <th>Recorded</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var result in Model)
                    {
                        <tr>
                            <td>@result.EventName</td>
                            <td>@result.Position</td>
                            <td>@result.FinishTime.ToString(@"hh\:mm\:ss")</td>
                            <td>@result.ResultStatus</td>
                            <td>@result.RecordedAt.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>
