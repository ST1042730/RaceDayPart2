@model List<RaceDay.MVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Upcoming Races";
}

<div class="container mt-4 mb-5">

    <div class="p-4 mb-4 rounded-3 bg-dark text-white">
        <h1>Welcome to RaceDay!</h1>
        <p class="mb-0">Find your next challenge. Discover races and get ready to compete.</p>
    </div>

    <h2 class="mb-3">Upcoming Races</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No upcoming races are available at the moment.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var race in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <span class="badge bg-primary mb-2">
                                @race.EventType
                            </span>

                            <h4 class="card-title">
                                @race.EventName
                            </h4>

                            <p class="text-muted">
                                @race.Description
                            </p>

                            <hr />

                            <p>
                                <strong>Date:</strong>
                                @race.EventDate.ToString("dd MMMM yyyy")
                            </p>

                            <p>
                                <strong>Location:</strong>
                                @race.Location
                            </p>

                            <p>
                                <strong>Distance:</strong>
                                @race.DistanceKm km
                            </p>

                            <a asp-controller="Events"
                               asp-action="Details"
                               asp-route-id="@race.EventId"
                               class="btn btn-dark w-100">
                                View Race
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>