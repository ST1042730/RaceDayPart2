
@model List<RaceDay.MVC.Models.ParticipantEnrolmentViewModel>

@{
    ViewData["Title"] = "My Events";
}

<div class="container mt-4 mb-5">

    <h1 class="mb-4">My Events</h1>

    <p class="text-muted">
        View all the races you have registered for.
    </p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            You have not enrolled in any races yet.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var enrolment in Model)
            {
                <div class="col-md-6 mb-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">

                            <h4>@enrolment.EventName</h4>

                            <p>
                                <strong>Enrolment ID:</strong>
                                @enrolment.EnrolmentId
                            </p>

                            <p>
                                <strong>Enrolment Date:</strong>
                                @enrolment.EnrolmentDate.ToString("dd MMMM yyyy")
                            </p>

                            <p>
                                <strong>Status:</strong>
                                <span class="badge bg-success">
                                    @enrolment.Status
                                </span>
                            </p>

                            <a asp-controller="Events"
                               asp-action="Details"
                               asp-route-id="@enrolment.EventId"
                               class="btn btn-dark w-100">
                                View Race
                            </a>

                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>
