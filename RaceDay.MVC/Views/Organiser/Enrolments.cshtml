
@model List<RaceDay.MVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Event Enrolments";
}

<div class="container mt-4 mb-5">
    <h1>Event Enrolments</h1>
    <p class="text-muted">Select an event to view its registered participants.</p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No events available.</div>
    }
    else
    {
        <div class="row mt-4">
            @foreach (var race in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h4>@race.EventName</h4>
                            <p class="text-muted">@race.Location</p>
                            <p><strong>Date:</strong> @race.EventDate.ToString("dd MMM yyyy")</p>
                            <p><strong>Distance:</strong> @race.DistanceKm km</p>

                            <a asp-controller="Organiser"
                               asp-action="EventEnrolments"
                               asp-route-id="@race.EventId"
                               class="btn btn-primary w-100">
                                View Participants
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <a asp-action="Index" class="btn btn-outline-secondary">
        Back to Dashboard
    </a>
</div>
