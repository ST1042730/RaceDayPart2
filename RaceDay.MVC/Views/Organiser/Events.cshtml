
@model List<RaceDay.MVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Manage Events";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Manage Events</h1>
            <p class="text-muted">Create and manage your RaceDay events.</p>
        </div>

        <a asp-controller="Organiser"
           asp-action="CreateEvent"
           class="btn btn-primary">
            + Create Event
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No events found. Create your first event.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var race in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <span class="badge bg-primary">@race.Status</span>

                            <h4 class="mt-2">@race.EventName</h4>

                            <p class="text-muted">@race.Description</p>

                            <hr />

                            <p><strong>Date:</strong> @race.EventDate.ToString("dd MMM yyyy")</p>
                            <p><strong>Location:</strong> @race.Location</p>
                            <p><strong>Distance:</strong> @race.DistanceKm km</p>
                            <p><strong>Type:</strong> @race.EventType</p>

                            <a asp-controller="Organiser"
                               asp-action="EditEvent"
                               asp-route-id="@race.EventId"
                               class="btn btn-warning w-100 mb-2">
                                Edit Event
                            </a>

                            <form asp-controller="Organiser"
                                  asp-action="DeleteEvent"
                                  method="post"
                                  onsubmit="return confirm('Are you sure you want to delete this event?');">
                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@race.EventId" />

                                <button type="submit"
                                        class="btn btn-danger w-100">
                                    Delete Event
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <a asp-controller="Organiser"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Back to Dashboard
    </a>
</div>

