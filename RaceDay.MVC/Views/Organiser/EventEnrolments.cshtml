
@model List<RaceDay.MVC.Models.OrganiserEnrolmentViewModel>

@{
    ViewData["Title"] = "Registered Participants";
    var eventId = (int)(ViewBag.EventId ?? 0);
}

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Registered Participants</h1>
            <h5 class="text-muted">@ViewBag.EventName</h5>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Dashboard
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }
            else if (Model == null || Model.Count == 0)
            {
                <div class="alert alert-info">
                    No participants have enrolled in this event yet.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>Enrolment ID</th>
                                <th>Participant</th>
                                <th>Participant ID</th>
                                <th>Enrolment Date</th>
                                <th>Enrolment Status</th>
                                <th>Race Result</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var enrolment in Model)
                            {
                                <tr>
                                    <td>@enrolment.EnrolmentId</td>

                                    <td>
                                        @enrolment.FirstName @enrolment.LastName
                                    </td>

                                    <td>@enrolment.ParticipantId</td>

                                    <td>
                                        @enrolment.EnrolmentDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        <span class="badge bg-success">
                                            @enrolment.Status
                                        </span>
                                    </td>

                                    <td style="min-width: 260px;">

                                        @if (enrolment.ResultId.HasValue)
                                        {
                                            <div class="alert alert-success mb-0">
                                                <strong>Result Recorded</strong>
                                                <hr />

                                                <div>
                                                    <strong>Finishing Time:</strong>
                                                    @(enrolment.FinishTime?.ToString(@"hh\:mm\:ss") ?? "N/A")
                                                </div>

                                                <div>
                                                    <strong>Position:</strong>
                                                    @(enrolment.Position?.ToString() ?? "N/A")
                                                </div>

                                                <div>
                                                    <strong>Status:</strong>
                                                    @(enrolment.ResultStatus ?? "Completed")
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <form asp-action="RecordResult"
                                                  method="post"
                                                  class="d-flex flex-column gap-2">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="EnrolmentId"
                                                       value="@enrolment.EnrolmentId" />

                                                <input type="hidden"
                                                       name="eventId"
                                                       value="@eventId" />

                                                <input type="text"
                                                       name="FinishTime"
                                                       class="form-control form-control-sm"
                                                       placeholder="HH:MM:SS"
                                                       pattern="[0-9]{1,2}:[0-5][0-9]:[0-5][0-9]"
                                                       title="Enter time as HH:MM:SS"
                                                       required />

                                                <input type="number"
                                                       name="Position"
                                                       class="form-control form-control-sm"
                                                       placeholder="Race position"
                                                       min="1"
                                                       required />

                                                <button type="submit"
                                                        class="btn btn-primary btn-sm">
                                                    Save Result
                                                </button>
                                            </form>
                                        }

                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>

    <a asp-action="Enrolments"
       class="btn btn-outline-primary mt-3">
        Back to Events
    </a>

</div>
