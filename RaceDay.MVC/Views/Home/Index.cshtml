
@{
    ViewData["Title"] = "RaceDay";
}

<div class="container mt-5 mb-5">
    <div class="p-5 rounded-4 bg-dark text-white text-center">
        <h1 class="display-3 fw-bold">RACEDAY</h1>
        <h3 class="mt-3">Your Race. Your Journey. Your Day.</h3>
        <p class="lead mt-3">
            Discover upcoming races, register for events and track your results.
        </p>

        <div class="mt-4">
            <a asp-controller="Account" asp-action="Login"
               class="btn btn-primary btn-lg me-2">
                Login
            </a>

            <a asp-controller="Account" asp-action="Register"
               class="btn btn-outline-light btn-lg">
                Register
            </a>
        </div>
    </div>
</div>
